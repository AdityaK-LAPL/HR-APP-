# Copy this file to .env and fill in real values. Never commit .env.

# "production" turns on Secure cookies and HSTS, switches off /docs, and makes start-up demand
# DEBUG=false and an https:// CORS_ALLOWED_ORIGINS list (never "*").
ENVIRONMENT=development
DEBUG=true

# Supabase Postgres connection string, using the async driver.
# Example: postgresql+asyncpg://postgres:<password>@<host>:5432/postgres
# In production append ?ssl=require (the application refuses to start without it for a non-local
# database; ssl=verify-full with the provider's CA certificate is better still).
# Use the Session pooler host (not Direct connection, which is IPv6-only on
# most Supabase projects; not Transaction pooler, which doesn't support the
# prepared statements asyncpg uses by default).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/company_app

# SQLAlchemy connection pool size. Supabase's pooled connection modes cap
# concurrent client connections per project on a shared, fairly low limit
# (their defaults collide with SQLAlchemy's own default of up to 15 - see
# app/db/session.py) - keep these conservative against a pooler, raise them
# against a direct/unpooled connection in production.
DB_POOL_SIZE=5
# A query / connection attempt that stalls (e.g. the pooler drops a connection silently) fails after this many seconds instead of hanging the request.
DB_COMMAND_TIMEOUT_SECONDS=60
DB_CONNECT_TIMEOUT_SECONDS=30
DB_MAX_OVERFLOW=2

# Optional: only needed if/when Supabase Storage or the Supabase management API is used directly.
# Without these, attachments fall back to local-filesystem storage (see app/services/storage.py).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attachments

# Used only by the local-filesystem attachment storage fallback above.
LOCAL_STORAGE_DIR=var/attachments
ATTACHMENT_SIGNED_URL_EXPIRE_SECONDS=300
ATTACHMENT_MAX_SIZE_BYTES=26214400

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# The application REFUSES TO START with a value shorter than 32 characters or one that begins
# "changeme" - replace this placeholder.
JWT_SECRET_KEY=changeme-generate-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO

# Rate limit on POST /auth/login and /auth/refresh (per client IP, single
# process - see app/core/rate_limit.py).
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Database role each request switches to so PostgreSQL RLS applies (migration 0013).
APP_DB_ROLE=hr_app_rls

# The single company timezone (IANA name). Business calendar dates (attendance day, "today") follow it.
COMPANY_TIMEZONE=Asia/Kolkata
