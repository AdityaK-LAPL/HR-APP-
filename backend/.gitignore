*.pyc
# No trailing slash: also matches when .venv is a symlink (this project's
# real venv lives outside the repo at ~/.venvs/, because Python's venv
# module refuses to create an environment inside a path containing ':',
# which the parent "antigravity-ide:/HR APP Antigravity" directory has).
.venv
venv/
.env
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Local-filesystem attachment storage fallback (app/services/storage.py) -
# may contain uploaded file content, never commit it.
var/
